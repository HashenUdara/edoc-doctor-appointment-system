rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role(name) { return signedIn() && request.auth.token.role == name; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    match /patient-profiles/{uid}/{fileName} {
      allow read: if verified() && (request.auth.uid == uid || role('admin'));
      allow write: if verified() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /patient-reports/{uid}/{fileName} {
      allow read: if verified() && (
        request.auth.uid == uid || role('admin') || role('lab')
      );
      allow write: if verified() && (role('admin') || role('lab'))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}