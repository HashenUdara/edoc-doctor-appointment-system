rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /patient-reports/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role in ['admin','doctor','lab']);
      allow write: if request.auth != null && request.auth.token.role in ['admin','lab'] && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('application/pdf|image/.*');
    }
    match /{allPaths=**} { allow read,write: if false; }
  }
}
